{
  "titulo": "Mamá conoce a Marcos",
  "duracion": 24,
  "audio": "Guia de montaje; no se incluyen voces ni musica sintetizadas.",
  "escenas": [
    {
      "inicio": 0.0,
      "fin": 2.0,
      "rol": "Hija",
      "voz": "Hija",
      "texto": "¡Mamá, hoy conoces a Marcos!",
      "voz_interior": false
    },
    {
      "inicio": 2.0,
      "fin": 3.5,
      "rol": "Madre",
      "voz": "Madre",
      "texto": "¡Por fin! ¿Dónde está?",
      "voz_interior": false
    },
    {
      "inicio": 3.5,
      "fin": 5.5,
      "rol": null,
      "voz": null,
      "texto": "",
      "voz_interior": false
    },
    {
      "inicio": 5.5,
      "fin": 7.5,
      "rol": "Hija",
      "voz": "Hija",
      "texto": "Mamá, este es Marcos.",
      "voz_interior": false
    },
    {
      "inicio": 7.5,
      "fin": 10.0,
      "rol": "Novio",
      "voz": "Marcos",
      "texto": "Buenas tardes, señora.",
      "voz_interior": false
    },
    {
      "inicio": 10.0,
      "fin": 14.0,
      "rol": "Madre",
      "voz": "Madre",
      "texto": "¿Dónde me he metido? ¿Qué me ha traído mi hija?",
      "voz_interior": true
    },
    {
      "inicio": 14.0,
      "fin": 16.0,
      "rol": "Hija",
      "voz": "Hija",
      "texto": "Mamá… no empieces.",
      "voz_interior": false
    },
    {
      "inicio": 16.0,
      "fin": 19.0,
      "rol": "Madre",
      "voz": "Madre",
      "texto": "Quítate eso… ¡y súbete los pantalones!",
      "voz_interior": false
    },
    {
      "inicio": 19.0,
      "fin": 21.5,
      "rol": "Novio",
      "voz": "Marcos",
      "texto": "¡Sí, señora! Mi madre dice lo mismo.",
      "voz_interior": false
    },
    {
      "inicio": 21.5,
      "fin": 22.5,
      "rol": "Hija",
      "voz": "Hija",
      "texto": "¡Tierra, trágame!",
      "voz_interior": false
    },
    {
      "inicio": 22.5,
      "fin": 24.0,
      "rol": "Madre",
      "voz": "Madre",
      "texto": "¡Y la gorra!",
      "voz_interior": false
    }
  ],
